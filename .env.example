# docker-compose settings - copy to .env (never commit .env)
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n=' ; echo

# URL clients use to reach this server (your domain, https in production).
PUBLIC_BASE_URL=https://storage.example.com

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

JWT_ACCESS_SECRET=
URL_SIGNING_SECRET=
API_KEY_PEPPER=

# Where file bytes live on the host (put it on the large EBS volume).
STORAGE_HOST_PATH=/srv/cloud-storage/data

# x-accel = nginx sends the bytes (fast, sendfile). stream = Node sends them.
SERVE_MODE=x-accel
MAX_UPLOAD_SIZE_BYTES=1073741824
DEFAULT_TENANT_STORAGE_LIMIT_BYTES=53687091200
TRASH_RETENTION_DAYS=30
PUBLIC_CACHE_MAX_AGE=86400

# Private deployment: create tenants with the CLI instead of open sign-up.
REGISTRATION_ENABLED=false
SWAGGER_ENABLED=false
DASHBOARD_ORIGINS=
LOG_LEVEL=info

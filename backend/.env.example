# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Public base URL clients use to reach this server (no trailing slash).
# Signed upload/download URLs and public file URLs are built from it.
PUBLIC_BASE_URL=http://localhost:3000
# Set when running behind nginx / a load balancer so client IPs are correct.
TRUST_PROXY=false
LOG_LEVEL=info
SWAGGER_ENABLED=true
# Allow anyone to create a tenant via POST /api/v1/auth/register.
# On a private deployment set false and create tenants with the CLI.
REGISTRATION_ENABLED=true
# Browser origins of the management dashboard (comma separated).
DASHBOARD_ORIGINS=http://localhost:3001

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@127.0.0.1:3306/cloud_storage

# ─── Redis (leave REDIS_HOST empty to run without Redis: in-process
#     rate limiting / cache / jobs - single instance only) ─────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=cs:

# ─── Auth ─────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Signs upload/download URLs (HMAC-SHA256).
URL_SIGNING_SECRET=
# Pepper mixed into API key hashes.
API_KEY_PEPPER=

# ─── Storage (local disk on this server) ──────────────────────
STORAGE_DRIVER=local
STORAGE_ROOT=/var/lib/cloud-storage/data
# stream = Node streams the bytes; x-accel = nginx serves them (X-Accel-Redirect, recommended in production)
SERVE_MODE=stream
X_ACCEL_PREFIX=/_protected/
UPLOAD_URL_EXPIRES=600
DOWNLOAD_URL_EXPIRES=300
MAX_UPLOAD_SIZE_BYTES=1073741824
DEFAULT_TENANT_STORAGE_LIMIT_BYTES=53687091200
TRASH_RETENTION_DAYS=30
# Cache-Control max-age (seconds) for public file URLs.
PUBLIC_CACHE_MAX_AGE=86400
# Generate image variants (thumb/small/medium/large webp) in the background right after upload.
IMAGE_VARIANTS_EAGER=true

# ─── Rate limits (requests per minute) ────────────────────────
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_API_PER_MIN=1000
RATE_LIMIT_PRESIGN_PER_MIN=100
RATE_LIMIT_DOWNLOAD_PER_MIN=500
